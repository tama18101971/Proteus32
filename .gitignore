.pio
.cache/
.kilo/

# compile_commands.json is per-machine by construction: clangd needs an
# absolute `directory` plus absolute PlatformIO package dirs and expands
# neither $VAR/%VAR% nor ~ in it, so a committed copy is only valid on the
# machine that wrote it. Regenerate with `python tools/gen_compile_db.py`
# after every clone and after any build_flags change.
compile_commands*.json

.env
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/extensions.json

# serena: project.yml and memories/ ARE tracked (shared team knowledge — do not
# re-add a blanket ".serena" rule here, it would silently drop new memories
# from git). The nested .serena/.gitignore excludes cache/ and
# project.local.yml, which are per-machine.

# python
__pycache__/
*.pyc
.pytest_cache/

dist/
build/
Proteus32Flasher.spec

.playwright-mcp/

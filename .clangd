# clangd configuration (shared by every machine — no absolute paths here).
#
# Include paths are NOT listed below: they can only come from
# compile_commands.json, which is per-machine by construction. clangd needs
# `directory` and the PlatformIO package dirs (~/.platformio/packages/...) to
# be absolute and expands neither $VAR/%VAR% nor ~ inside
# compile_commands.json, so a committed database is only valid on the machine
# that produced it. Hence `compile_commands.json` is gitignored and must be
# regenerated after every clone with:  python tools/gen_compile_db.py
# Without it clangd silently loses every -I and reports "file not found"
# cascades: the -I entries below are then resolved against the *source file's*
# own directory, not against the project root.
CompileFlags:
  CompilationDatabase: .
  Compiler: clang
  # GCC-only / WCH-specific flags that clangd's clang rejects (rejection makes
  # clangd fall back to flagless parsing -> "file not found" cascade):
  Remove: [-march=*, -mabi=*, -msmall-data-limit=*, -fmessage-length=*, -msave-restore, -flto]
  Add:
    - -target
    - riscv32
    # Project-relative, so they survive a moved/renamed checkout. Needed for
    # files the database has no entry for (new sources, headers): clangd then
    # infers a command from the nearest database entry and keeps the project
    # root as the working directory.
    - -I
    - include
    - -I
    - src
    # WL_FLASH moved from a vendored libs/WL_FLASH (removed in d242824) to the
    # lib_deps remote pin; the real path is env-specific
    # (.pio/libdeps/<env>/WL_FLASH/src) and the database supplies it. This
    # entry only covers a database generated before the dependency was
    # installed; it is inert until .pio/libdeps/Proteus32 exists.
    - -I
    - .pio/libdeps/Proteus32/WL_FLASH/src
    - -DCH32V003
    - -DCH32V00X
    - -DCH32V00x
    - -DCH32V003F4
    # Keep in sync with platformio.ini build_flags (WL_FLASH payload layout +
    # Option-Bytes overlay); stale values make clangd/Serena mis-parse app_cfg_t
    # and drop all WL_OB_ENABLE-gated code paths.
    - -DWL_OB_ENABLE
    - -DWL_FORMAT_VERSION=4
    - -DWL_RECORD_SIZE=16
    - -DWL_CRC_BITS=16
    - -DSYSCLK_FREQ_24MHz_HSI=24000000
    - -DSYSCLK_FREQ_24MHZ_HSI=24000000
    # -Oz is a build_src_flags entry, applied to src/*.c on top of the
    # platform's -Os (last -O* wins).  Kept here so the parsed configuration
    # matches the real per-TU optimisation level; clang only accepts it for
    # size, and its inlining heuristics otherwise differ from the build.
    - -Oz
    - -Wno-ignored-attributes
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
